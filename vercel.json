{
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.php",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/(.*).php",
      "destination": "/$1",
      "permanent": true
    }
  ]
}
